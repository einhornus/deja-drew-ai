# Your OpenRouter key. Pays for the LLM calls and the image model.
OPENROUTER_API_KEY=

# Optional. Comma-separated OpenRouter LLM ids, tried in order, instead of
# the built-in tier lists, e.g. anthropic/claude-sonnet-4.5,google/gemini-3-flash-preview
DEJADREW_LLM_MODELS=
# Optional. Comma-separated OpenRouter LLM ids replacing one built-in tier list.
# tier="high" tries the high list, then medium, then low.
DEJADREW_MODELS_HIGH=
DEJADREW_MODELS_MEDIUM=
DEJADREW_MODELS_LOW=
# Optional. Where LLM answers and seeded images are cached (default .cache/dejadrew).
DEJADREW_CACHE_DIR=
# Optional. 0 turns both caches off.
DEJADREW_CACHE=
# Optional. Output-token cap of one LLM call (default 16384). Thinking models
# spend this on reasoning first; too low and the structured answer is lost.
DEJADREW_MAX_TOKENS=
